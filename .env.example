# Set automatically by the Neon integration on Vercel (DATABASE_URL or POSTGRES_URL, either works)
DATABASE_URL=
# Login password (long and unique)
APP_PASSWORD=
# Random secret for signing the login cookie: openssl rand -base64 32
AUTH_SECRET=
# Random secret Vercel sends to the cron route: openssl rand -base64 32
CRON_SECRET=
# Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-haiku-5-5)
AI_MODEL=
