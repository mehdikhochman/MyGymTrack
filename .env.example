# Set automatically by the Neon integration on Vercel (DATABASE_URL or POSTGRES_URL, either works)
DATABASE_URL=
# Random secret Vercel sends to the cron routes: openssl rand -base64 32
CRON_SECRET=
# AI coach: an OpenRouter key (openrouter.ai), or an Anthropic key (console.anthropic.com).
# OpenRouter is used when its key is set. Without any key the app works, minus the AI coach.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Optional: models. Defaults with OpenRouter: anthropic/claude-opus-5.5 (programmes, weekly reviews) and
# anthropic/claude-haiku-5.5 (translation, research); with Anthropic: claude-opus-5-5 and claude-haiku-5-5.
AI_COACH_MODEL=
AI_MODEL=
# Password reset e-mails (resend.com): API key and a sender on a domain verified in Resend, e.g. "MyGymTrack <no-reply@mydomain.fr>"
RESEND_API_KEY=
EMAIL_FROM=
# E-mail of the account that inherits the data of the single-user version (v1)
OWNER_EMAIL=
# Public URL used in e-mails (defaults to the Vercel production URL)
APP_URL=
# Streak reminders (web push): generate with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
